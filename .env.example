# GhYiAb V2 — Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED - Telegram Bot
# ============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_OWNER_ID=123456789

# ============================================================================
# DATABASE - Choose one (PostgreSQL for production, MySQL for Railway)
# ============================================================================
# PostgreSQL (Production)
DATABASE_URL=postgresql://ghyiab:password@localhost:5432/ghyiab

# MySQL (Railway)
# DATABASE_URL=mysql://ghyiab:password@localhost:3306/ghyiab

# SQLite (Development only)
# DATABASE_URL=sqlite:///./data/ghyiab.db
# Or use GHIYAB_DB_PATH for SQLite (used by init_db tool)
GHIYAB_DB_PATH=./data/ghyiab.db

# ============================================================================
# REDIS - For caching and sessions
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# VPN Provider (X-UI / 3x-ui)
# ============================================================================
VPN_PROVIDER=xui
XUI_BASE_URL=https://your-panel.example.com
XUI_API_TOKEN=your_api_token_here
XUI_TIMEOUT=30
XUI_VERIFY_TLS=true
XUI_SUB_URL_BASE=https://sub.domain.com:2096/sub/
XUI_MAX_RETRIES=2

# ============================================================================
# OTHER VPN PROVIDERS (Optional - enable as needed)
# ============================================================================
# Marzban
# MARZBAN_BASE_URL=https://marzban.example.com
# MARZBAN_USERNAME=admin
# MARZBAN_PASSWORD=password

# Hiddify
# HIDDIFY_BASE_URL=https://hiddify.example.com
# HIDDIFY_API_KEY=your_api_key

# WGDashboard
# WGDASHBOARD_BASE_URL=https://wg.example.com
# WGDASHBOARD_USERNAME=admin
# WGDASHBOARD_PASSWORD=password

# Marzneshin
# MARZNESHIN_BASE_URL=https://marzneshin.example.com
# MARZNESHIN_USERNAME=admin
# MARZNESHIN_PASSWORD=password

# Mikrotik
# MIKROTIK_HOST=192.168.1.1
# MIKROTIK_USERNAME=admin
# MIKROTIK_PASSWORD=password
# MIKROTIK_PORT=443

# Alireza
# ALIREZA_BASE_URL=https://alireza.example.com
# ALIREZA_API_KEY=your_api_key

# S-UI
# SUI_BASE_URL=https://sui.example.com
# SUI_USERNAME=admin
# SUI_PASSWORD=password

# Guard
# GUARD_BASE_URL=https://guard.example.com
# GUARD_API_KEY=your_api_key

# Manualsale
# MANUALSALE_BASE_URL=https://manualsale.example.com
# MANUALSALE_API_KEY=your_api_key

# IBSng
# IBSNG_BASE_URL=https://ibsng.example.com
# IBSNG_USERNAME=admin
# IBSNG_PASSWORD=password

# ============================================================================
# PAYMENT GATEWAYS (Iranian)
# ============================================================================
# Zarinpal
ZARINPAL_MERCHANT_ID=your_merchant_id
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL=https://yourdomain.com/callback/zarinpal

# IDPay
IDPAY_API_KEY=your_api_key
IDPAY_SANDBOX=false
IDPAY_CALLBACK_URL=https://yourdomain.com/callback/idpay

# Zibal
ZIBAL_MERCHANT_ID=your_merchant_id
ZIBAL_CALLBACK_URL=https://yourdomain.com/callback/zibal

# NextPay
NEXTPAY_API_KEY=your_api_key
NEXTPAY_CALLBACK_URL=https://yourdomain.com/callback/nextpay

# Aqayepardakht
AQAYEPARDAMKT_MERCHANT_ID=your_merchant_id
AQAYEPARDAMKT_CALLBACK_URL=https://yourdomain.com/callback/aqayepardakht

# PayPing
PAYPING_API_KEY=your_api_key
PAYPING_CALLBACK_URL=https://yourdomain.com/callback/payping

# ============================================================================
# CRYPTO PAYMENTS
# ============================================================================
# TON
TON_API_KEY=your_tonapi_key
TON_WALLET_ADDRESS=your_ton_wallet

# TRON
TRON_API_KEY=your_trongrid_key
TRON_WALLET_ADDRESS=your_trx_wallet

# USDT (ERC20/TRC20)
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ============================================================================
# BANK CARDS (Card-to-Card payments)
# ============================================================================
CARD_NUMBER=1234567890123456
CARD_NAME=Your Name

# ============================================================================
# CHANNEL & RULES
# ============================================================================
CHANNEL_ID=@yourchannel
RULES_TEXT=Please read and accept the rules before using the bot.

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# ============================================================================
# BACKUP
# ============================================================================
BACKUP_DIR=/app/backups
GHIYAB_BACKUP_DIR=/var/lib/ghyiab-v2/backups
BACKUP_RETENTION_DAYS=30

# ============================================================================
# LOGS
# ============================================================================
GHIYAB_LOG_DIR=/var/log/ghyiab-v2

# ============================================================================
# EXPORTS
# ============================================================================
EXPORTS_DIR=/app/exports

# ============================================================================
# MINI APP
# ============================================================================
VITE_API_URL=http://localhost:8000/api
MINI_APP_URL=https://yourdomain.com/mini-app

# ============================================================================
# ADMIN SETTINGS
# ============================================================================
ADMIN_IDS=123456789,987654321

# ============================================================================
# FEATURE FLAGS
# ============================================================================
DICE_ENABLED=true
DICE_COOLDOWN_HOURS=24
DICE_DAILY_BUDGET_MINOR=1000000
REFERRAL_BONUS_MINOR=50000
REFERRAL_TRIGGER=signup