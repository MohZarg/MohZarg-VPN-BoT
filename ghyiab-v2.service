# GhYiAb V2 — systemd Service Unit
# نصب: sudo cp ghyiab-v2.service /etc/systemd/system/
# فعال‌سازی: sudo systemctl daemon-reload && sudo systemctl enable --now ghyiab-v2

[Unit]
Description=GhYiAb V2 — Telegram VPN Bot
Documentation=https://github.com/your-repo/ghyiab_v2
After=network-online.target
Wants=network-online.target
# اگر 3x-ui روی همان سرور است، بعد از آن شروع شود (اختیاری)
# After=x-ui.service

[Service]
Type=exec
# کاربر و گروه اختصاصی (ایجاد: sudo useradd -r -s /usr/sbin/nologin -d /var/lib/ghyiab-v2 ghyiab)
User=ghyiab
Group=ghyiab

# دایرکتوری کاری
WorkingDirectory=/opt/ghyiab-v2

# فایل محیط (مقداردهی متغیرهای محیطی)
EnvironmentFile=-/etc/ghyiab-v2/env

# اجرا با python3 مستقیم (virtualenv توصیه نمی‌شود برای systemd)
ExecStart=/usr/bin/python3 -m bot

# ری‌استارت خودکار
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# سخت‌افزاری و امنیتی
# محدودیت حافظه (VPS کوچک)
MemoryMax=300M
MemorySwapMax=0

# امنیت: حداقل دسترسی
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# فقط مسیرهای لازم قابل نوشتن
ReadWritePaths=/var/lib/ghyiab-v2 /var/log/ghyiab-v2 /etc/ghyiab-v2
# جلوگیری از دسترسی به 3x-ui (اگر روی همان سرور است)
InaccessiblePaths=/opt/3x-ui /etc/x-ui

# لاگینگ
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghyiab-v2

# محدودیت فایل‌های باز
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target